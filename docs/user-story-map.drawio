        <mxCell id="US-21" data-release="v1.2" data-story="Как житель, я хочу обсуждать вопросы дома в чате подтверждённых жильцов, чтобы договариваться с соседями в одном месте." data-task="T13" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dceeff;strokeColor=#78a6d2;fontColor=#172b4d;fontFamily=Arial;fontSize=14;spacing=10;align=left;verticalAlign=top;" value="US-21 · v1.2&#xa;Житель&#xa;Домовой чат" vertex="1">
