        <mxCell id="US-20" data-release="v1.2" data-story="Как житель, я хочу сравнивать категории расходов за несколько периодов, чтобы замечать изменения и задавать предметные вопросы." data-task="T06" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dceeff;strokeColor=#78a6d2;fontColor=#172b4d;fontFamily=Arial;fontSize=14;spacing=10;align=left;verticalAlign=top;" value="US-20 · v1.2&#xa;Житель&#xa;Динамика расходов" vertex="1">
