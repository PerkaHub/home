        </mxCell>
        <mxCell id="US-15" data-release="v1.1" data-story="Как житель, я хочу создать обращение по начислению или дому и видеть его статус, чтобы получить отслеживаемый ответ." data-task="T11" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dceeff;strokeColor=#78a6d2;fontColor=#172b4d;fontFamily=Arial;fontSize=14;spacing=10;align=left;verticalAlign=top;" value="US-15 · v1.1&#xa;Житель&#xa;Обращение в УК/ТСЖ" vertex="1">
