        <mxCell id="US-17" data-release="v1.1" data-story="Как житель, я хочу получать уведомления об изменении платежа и новых публикациях дома, чтобы не проверять обновления вручную." data-task="T12" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dceeff;strokeColor=#78a6d2;fontColor=#172b4d;fontFamily=Arial;fontSize=14;spacing=10;align=left;verticalAlign=top;" value="US-17 · v1.1&#xa;Житель&#xa;Уведомления" vertex="1">
