        <mxCell id="US-16" data-release="v1.1" data-story="Как представитель УК/ТСЖ, я хочу ответить на обращение и изменить его статус, чтобы довести решение вопроса до жителя." data-task="T11" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dceeff;strokeColor=#78a6d2;fontColor=#172b4d;fontFamily=Arial;fontSize=14;spacing=10;align=left;verticalAlign=top;" value="US-16 · v1.1&#xa;Представитель УК/ТСЖ&#xa;Ответ на обращение" vertex="1">
