        <mxCell id="US-19" data-release="v1.2" data-story="Как житель, я хочу переключаться между подтверждёнными лицевыми счетами, чтобы управлять сведениями нескольких помещений." data-task="T02" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dceeff;strokeColor=#78a6d2;fontColor=#172b4d;fontFamily=Arial;fontSize=14;spacing=10;align=left;verticalAlign=top;" value="US-19 · v1.2&#xa;Житель&#xa;Несколько лицевых счетов" vertex="1">
