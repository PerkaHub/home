        <mxCell id="US-22" data-release="v1.2" data-story="Как представитель УК/ТСЖ, я хочу модерировать сообщения по опубликованным правилам, чтобы сохранять полезное общение в чате дома." data-task="T13" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dceeff;strokeColor=#78a6d2;fontColor=#172b4d;fontFamily=Arial;fontSize=14;spacing=10;align=left;verticalAlign=top;" value="US-22 · v1.2&#xa;Представитель УК/ТСЖ&#xa;Модерация чата" vertex="1">
