        </mxCell>
        <mxCell id="US-14" data-release="v1.1" data-story="Как бухгалтер, я хочу видеть и проверять переданные показания по счёту и периоду, чтобы подготовить исходные сведения для расчётов." data-task="T10" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dceeff;strokeColor=#78a6d2;fontColor=#172b4d;fontFamily=Arial;fontSize=14;spacing=10;align=left;verticalAlign=top;" value="US-14 · v1.1&#xa;Бухгалтер&#xa;Приём показаний" vertex="1">
