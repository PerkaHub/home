        </mxCell>
        <mxCell id="US-23" data-release="v1.2" data-story="Как представитель УК/ТСЖ, я хочу опубликовать консультативный опрос с темой и сроком, чтобы собрать мнение жильцов без подмены общего собрания." data-task="T14" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dceeff;strokeColor=#78a6d2;fontColor=#172b4d;fontFamily=Arial;fontSize=14;spacing=10;align=left;verticalAlign=top;" value="US-23 · v1.2&#xa;Представитель УК/ТСЖ&#xa;Создание опроса" vertex="1">
